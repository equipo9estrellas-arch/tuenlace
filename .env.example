# ─────────────────────────────────────────────────────────────
#  TUENLACE — variables de entorno
#  Copia este fichero a .env y rellena los valores.
#
#  Solo DATABASE_URL y AUTH_SECRET son obligatorias. Sin el resto
#  la aplicación arranca igual y degrada con elegancia.
# ─────────────────────────────────────────────────────────────

# Base de datos PostgreSQL (Railway, o Neon en Frankfurt)
DATABASE_URL="postgresql://usuario:password@host:5432/tuenlace"

# URL pública de la aplicación, sin barra final.
# TODAS las páginas viven bajo este dominio: tuenlace.es/loquesea.
# No hay subdominios ni dominios de cliente.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secreto para firmar las sesiones. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Resend — email transaccional. Sin esta clave, los enlaces mágicos
# se imprimen por consola (modo desarrollo).
RESEND_API_KEY=""
MAIL_FROM="TUENLACE <hola@tuenlace.es>"

# Google Safe Browsing — comprobación de enlaces salientes.
# Sin clave, la comprobación se salta y se registra un aviso.
SAFE_BROWSING_API_KEY=""

# Generación de textos con IA. Sin clave, el generador usa
# únicamente las reglas deterministas (que cubren la mayoría de casos).
AI_API_KEY=""
AI_API_URL="https://api.openai.com/v1/chat/completions"
AI_MODEL="gpt-4o-mini"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ESENCIAL_MENSUAL=""
STRIPE_PRICE_ESENCIAL_ANUAL=""
STRIPE_PRICE_NEGOCIO_MENSUAL=""
STRIPE_PRICE_NEGOCIO_ANUAL=""
STRIPE_PRICE_AGENCIA_MENSUAL=""
STRIPE_PRICE_AGENCIA_ANUAL=""
